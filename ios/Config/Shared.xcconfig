// Shared build settings for Manhunt Crews.
// Override any of these in Config/Local.xcconfig (git-ignored), e.g. your
// Apple Development Team ID and a unique bundle identifier.

MH_BUNDLE_ID = com.manhuntcrews.dev
MH_DEVELOPMENT_TEAM =
// Free Personal Team builds cannot use Push or Sign in with Apple entitlements.
MH_ENTITLEMENTS = ManhuntCrews/ManhuntCrews.entitlements
MH_FIREBASE_PROJECT_ID = demo-manhunt
MH_ENABLE_APPLE_SIGN_IN = NO
MH_ENABLE_PUSH = NO
MH_DEV_HOST = 127.0.0.1
// Firebase client config for non-emulator builds: ManhuntCrews/<name>.plist (git-ignored).
MH_FIREBASE_PLIST = GoogleService-Info
// Privacy policy and support pages (Firebase Hosting, hosting/public), linked from Settings.
// Set your site in Local.xcconfig / Prod.local.xcconfig.
MH_SITE_URL = https:/$()/your-prod-project.web.app
