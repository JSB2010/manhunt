<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Prod (TestFlight/App Store). The App ID needs the Push Notifications capability;
	     add com.apple.developer.applesignin here only after enabling Sign in with Apple
	     on the App ID and regenerating the provisioning profile. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
