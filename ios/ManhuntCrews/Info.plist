<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>MHApiBaseURL</key>
	<string>$(MH_API_BASE_URL)</string>
	<key>MHUseEmulators</key>
	<string>$(MH_USE_EMULATORS)</string>
	<key>MHDevHost</key>
	<string>$(MH_DEV_HOST)</string>
	<key>MHFirebaseProjectId</key>
	<string>$(MH_FIREBASE_PROJECT_ID)</string>
	<key>MHEnableAppleSignIn</key>
	<string>$(MH_ENABLE_APPLE_SIGN_IN)</string>
	<key>MHEnablePush</key>
	<string>$(MH_ENABLE_PUSH)</string>
	<key>MHBuildFlavor</key>
	<string>$(MH_BUILD_FLAVOR)</string>
	<key>MHFirebasePlist</key>
	<string>$(MH_FIREBASE_PLIST)</string>
	<key>MHSiteURL</key>
	<string>$(MH_SITE_URL)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Manhunt Crews tracks your location only during rounds you start, even with the screen locked; other crews get only scheduled pings.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Keeps tracking during a round you start while the screen is locked, and stops when the round ends; other crews get only scheduled pings.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>RoundTracking</key>
		<string>Precise location keeps pings and distances accurate during a round.</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Take a catch photo for the hiding crew to confirm; location metadata is removed.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Development builds connect to the Manhunt Crews server running on your local network.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.manhuntcrews.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>manhuntcrews</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
</dict>
</plist>
